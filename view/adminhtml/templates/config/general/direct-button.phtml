/** @var DirectButton $block */

use MultiSafepay\ConnectAdminhtml\Block\Adminhtml\Form\Field\DirectButton;

$elementHtml = $block->getData('element_html');
$fieldId = $block->getData('field_id');
$initialValue = $block->getData('initial_value');
$paymentCode = $block->getData('payment_code');
$warningMessage = $block->getData('warning_message');
$acknowledgementLabel = $block->getData('acknowledgement_label');

$containerId = $fieldId . '_direct_button_notice';
$checkboxId = $fieldId . '_acknowledged';
?>
<div class="multisafepay-direct-button-field">
    <?= /* @noEscape */ $elementHtml ?>

    <div id="<?= $block->escapeHtmlAttr($containerId) ?>"
         class="multisafepay-direct-button-notice"
         style="display:none; margin-top: 12px;">
        <div class="message message-warning" style="margin-bottom: 10px;">
            <div><?= $block->escapeHtml($warningMessage) ?></div>
        </div>

        <div class="admin__field admin__field-option">
            <input type="checkbox"
                   id="<?= $block->escapeHtmlAttr($checkboxId) ?>"
                   class="admin__control-checkbox multisafepay-direct-button-acknowledged" />
            <label class="admin__field-label" for="<?= $block->escapeHtmlAttr($checkboxId) ?>">
                <span><?= $block->escapeHtml($acknowledgementLabel) ?></span>
            </label>
        </div>

        <div class="multisafepay-direct-button-error message message-error"
             style="display:none; margin-top: 10px;">
            <div><?= $block->escapeHtml(__('You must confirm the prerequisites before saving.')) ?></div>
        </div>
    </div>
</div>

<script type="text/x-magento-init">
    {
        "#<?= $block->escapeJs($fieldId) ?>": {
        "MultiSafepay_ConnectAdminhtml/js/direct-button-validation": {
            "initialValue": "<?= $block->escapeJs($initialValue) ?>",
            "containerId": "<?= $block->escapeJs($containerId) ?>",
            "checkboxId": "<?= $block->escapeJs($checkboxId) ?>"
        }
    }
}
</script>

{
    "name": "multisafepay/magento2-adminhtml",
    "description": "MultiSafepay backend module for Magento 2",
    "version": "1.40.1",
    "require": {
        "multisafepay/magento2-core": "^3.21",
        "magento/framework": "^102.0|^103.0",
        "magento/module-backend": "^101.0|^102.0",
        "magento/module-config": "^101.0",
        "magento/module-customer": "^102.0|^103.0",
        "ext-zip": "*"
    },
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MultiSafepay\\ConnectAdminhtml\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
